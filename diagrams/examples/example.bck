BlockDiagram diagram = new BlockDiagram();
diagram.setTitle("Login flow");
diagram.setDescription(default::null);

Terminator start = new Terminator();
start.setTitle("Open login page");

Process capture = new Process();
capture.setTitle("Write username and password");

Decision check = new Decision();
check.setTitle("Right credentials?");

Process cancelAction = new Process();
cancelAction.setTitle("Successful operation");

Process thirdPartAction = new Process();
thirdPartAction.setTitle("Cancel the operation");

start.setNext(capture);
capture.setNext(check);
check.setYes(cancelAction);
check.setNo(thirdPartAction);

diagram.addBlock(start);
diagram.addBlock(capture);
diagram.addBlock(check);
diagram.addBlock(cancelAction);
diagram.addBlock(thirdPartAction);
diagram.setColor(Colors::new(255, 255, 255));
